{
	"schemaVersion": 1,
	"id": "filobulus",
	"version": "${version}",
	"name": "Filobulus",
	"description": "Endgame mining mod for Hypixel Skyblock: Glacite Tunnels and Glacite Mineshafts.",
	"authors": [
		"Filipovych"
	],
	"contact": {
		"sources": "https://github.com/filipovych/filobulus"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/filobulus/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.filipovych.filobulus.client.FilobulusClient"
		]
	},
	"mixins": [
		{
			"config": "filobulus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~${minecraft}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api}",
		"resourcefulconfig": ">=${resourceful_config}"
	}
}
